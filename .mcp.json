{
  "servers": {
    "dxdocs": {
      "url": "https://api.devexpress.com/mcp/docs",
      "type": "http"
    },
    "dxdocs26_1": {
      "url": "https://api.devexpress.com/mcp/docs?v=26.1",
      "type": "http"
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:5432/fatturafacile"
      ]
    },
    "git": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-git", "."]
    }
  },
  "mcpServers": {
    "laravel-boost": {
      "command": "php",
      "args": ["artisan", "boost:mcp"]
    }
  }
}
